# Дополнительный запуск с локальной Supabase: cp .env.local-supabase.example .env.local-supabase (см. docs/docker.md).
# Эти значения нужны ТОЛЬКО для локального запуска на своём компьютере: порты открыты на 127.0.0.1. Ключи моделей
# (GigaChat, NVIDIA) и демо-аккаунты по-прежнему берутся из .env. На облачную Supabase и на сервер эти ключи не годятся.
# Пароль Postgres: только буквы и цифры (он стоит в строке подключения). Для локального запуска сойдёт любой.
POSTGRES_PASSWORD=local-postgres-password
# Секрет JWT: не короче 32 символов. Им подписаны оба ключа ниже; сменили секрет — выпустите ключи заново (jwt.io, HS256).
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Стандартные ключи демо из документации self-host Supabase, подписаны секретом выше (роль anon, iss supabase-demo).
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.b_lMH2mc5km7S9Lw_sRGGqE9IeiahYu-caevDcacKiY
# То же для роли service_role: в обход RLS, только на сервере.
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.kcyKZAiwnnBG9t6IVGO17bcVw574pVynTHYVdF4q-p0
