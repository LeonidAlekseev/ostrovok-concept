# Имена переменных .env; значения пустые. Можно вписать значения ниже или только AGE_SECRET_KEY: тогда остальные берутся из secrets.app.env.age.
# Готовый .env из зашифрованного файла: npm run secrets:reveal (см. docs/secrets.md).
# Ключ приложения age: одна строка AGE-SECRET-KEY-1… Откуда: выдаёт владелец проекта (age-keygen); на Vercel и в Docker только он нужен.
AGE_SECRET_KEY=
# Supabase: URL проекта. Откуда: Supabase Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase: публичный anon-ключ. Откуда: Project Settings → API → Project API keys → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase: серверный ключ в обход RLS, только на сервере. Откуда: Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase: строка подключения к базе (транзакционный пулер) для db:push, db:types, seed. Откуда: Project Settings → Database → Connection string.
SUPABASE_DB_URL=
# Демо-путешественник: почта входа «Войти как путешественник». Создаётся npm run db:seed, значение выбираем сами.
DEMO_USER_EMAIL=
# Демо-путешественник: пароль. Создаётся npm run db:seed, значение выбираем сами.
DEMO_USER_PASSWORD=
# Демо-отельер: почта входа «Войти как отельер». Создаётся npm run db:hotelier, значение выбираем сами.
DEMO_HOTELIER_EMAIL=
# Демо-отельер: пароль. Создаётся npm run db:hotelier, значение выбираем сами.
DEMO_HOTELIER_PASSWORD=
# NVIDIA API: ключ для всех моделей (ответы, эмбеддинги, реранк, фото). Откуда: build.nvidia.com → профиль → API Keys.
NVIDIA_API_KEY=
# GigaChat (Сбер): Authorization key. Откуда: developers.sber.ru → GigaChat API → «Authorization key» (в Studio: Настройки API → получить ключ).
GIGACHAT_AUTH_KEY=
# Vercel Cron: секрет для GET /api/hotelier/knowledge/retry (vercel.json, раз в 10 минут). Vercel сам шлёт его как Authorization: Bearer. Откуда: придумываем сами (openssl rand -hex 32), задаём в Vercel → Project Settings → Environment Variables.
CRON_SECRET=
