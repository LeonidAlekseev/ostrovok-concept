  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/secrets.mjs build",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
