    "db:push": "node --env-file-if-exists=.env.local scripts/db-push.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:seed:valencia": "node --env-file-if-exists=.env.local scripts/seed-valencia.ts",
    "db:load:ota-pages": "node --env-file-if-exists=.env.local scripts/load-ota-pages.ts",
    "db:rebuild:ota": "node --env-file-if-exists=.env.local scripts/rebuild-ota-hotels.ts",
    "db:embed": "node --env-file-if-exists=.env.local scripts/embed.ts",
    "db:features": "node --env-file-if-exists=.env.local scripts/hotel-features.ts",
    "db:osm-places": "node --env-file-if-exists=.env.local scripts/load-osm-places.ts",
    "db:city-places": "node --env-file-if-exists=.env.local scripts/load-city-places.ts",
    "db:clean:shared-photos": "node --env-file-if-exists=.env.local scripts/clean-shared-photos.ts",
