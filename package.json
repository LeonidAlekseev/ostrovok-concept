    "@types/react-dom": "^19.2.7",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
