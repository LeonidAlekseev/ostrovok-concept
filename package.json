    "@shadcn/react": "^0.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.1",
    "openpgp": "^6.3.2",
